# Macro provider defaults (keys load via env/load_alpha_vantage_secret.sh)
MACRO_PROVIDER_CHAIN=alpha,alpha_free,twelve,tiingo,fred
ALPHA_VANTAGE_BACKOFF_SECONDS=30

DATASET_1H_URI=artifacts/datasets/btc_features_1h_splits.npz
REG_MODEL_DIR_1H=gs://jc-financial-models-prod/tiingo_fallback_20251229/xgb_ret1h_with_ta
DIR_MODEL_DIR_1H=gs://jc-financial-models-prod/tiingo_fallback_20251229/xgb_dir1h_with_ta
LSTM_MODEL_DIR_1H=gs://jc-financial-models-prod/tiingo_fallback_20251229/lstm_dir1h
BILSTM_MODEL_DIR_1H=gs://jc-financial-models-prod/tiingo_fallback_20251229/bilstm_dir1h
GRU_MODEL_DIR_1H=gs://jc-financial-models-prod/tiingo_fallback_20251229/gru_dir1h
TRANSFORMER_MODEL_DIR_1H=gs://jc-financial-models-prod/tiingo_fallback_20251229/transformer_dir1h
META_ENSEMBLE_URI=artifacts/backtests/meta_ensemble_config.json
DATASET_4H_URI=artifacts/datasets/btc_features_multi_horizon_splits.npz
REG_MODEL_DIR_4H=gs://jc-financial-models-prod/tiingo_fallback_20251229/xgb_ret4h_v1
DIR_MODEL_DIR_4H=gs://jc-financial-models-prod/tiingo_fallback_20251229/xgb_dir4h_v1
LIVE_LOG_URI=artifacts/live/paper_trade_realtime.csv
PYTHONPATH=/app
RUN_SIGNAL_FORCE_DATASET=1
SPOT_PROVIDER=tiingo
ONCHAIN_SOURCE=fallback
FUNDING_PROVIDER=cryptocompare
